# Default: ESRI World Imagery satellite (no API key).
# Note ESRI uses {z}/{y}/{x} in the path, not {z}/{x}/{y}.
# VITE_TMS_BASE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# VITE_TMS_ATTRIBUTION=© Esri, Maxar, Earthstar Geographics

# TiTiler COG example (encode your COG URL in the query string):
# VITE_TMS_BASE_URL=https://your-titiler.example.com/tiles/WebMercatorQuad/{z}/{x}/{y}?url=https%3A%2F%2Fyour-bucket%2Fimagery.tif

# gdal2tiles static pyramid:
# VITE_TMS_BASE_URL=https://your-host.example.com/tiles/{z}/{x}/{y}.png

# VITE_TMS_SCHEME=WebMercator
# VITE_TMS_EXTENSION=png
# VITE_TMS_API_KEY=

# VITE_GEOAI_TASK=building-detection
# VITE_MAP_CENTER=12.482,41.885
# VITE_INFERENCE_ZOOM=17
